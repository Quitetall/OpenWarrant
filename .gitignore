/target
**/*.rs.bk

# SAS §59.1 "disposable": caches and derived state that must never be a source.
.openwarrant/cache/
.openwarrant/state/
# M17: the ledger's JSONL and the score's badge, report and trend, regenerated
# by `war admin compile` (`.openwarrant/.gitignore` says the same for adopters).
.openwarrant/ledger.jsonl
.openwarrant/score/
.openwarrant/.gitignore

# Generated views are NOT listed here on purpose. They are tracked on main,
# where only the Views workflow writes them (conformance/views.toml), and an
# ignore rule would hide a new one from that workflow's `git add`. On a branch
# the check is fast CI's `views.pr`, which refuses a pull request that carries
# one; `python3 conformance/views.py drop --base origin/main` takes them out.

# Python bytecode: build output, not source.
__pycache__/
*.pyc

# §44.6 gate-run receipts. Produced BY a run, with wall-clock timestamps that
# change every execution — committing them would dirty the tree on every
# `cargo xtask gate`. A receipt becomes committed evidence deliberately, as part
# of a resolution (OW-WAR-0046 deliverable 3), not as a side effect of running.
docs/receipts/

# war eval writes a result per run; only the baseline is committed.
evals/results/
