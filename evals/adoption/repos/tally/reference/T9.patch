@@ -20,3 +21,19 @@ def parse_date(text: str) -> dt.date:
         return dt.date.fromisoformat(text)
     except ValueError:
         raise DateError(f"invalid date '{text}'") from None
+
+
+def month_end(date: dt.date) -> dt.date:
+    """The last day of ``date``'s month."""
+    return date.replace(day=calendar.monthrange(date.year, date.month)[1])
+
+
+def month_spans(first: dt.date, last: dt.date) -> list[tuple[dt.date, dt.date]]:
+    """The calendar months overlapping ``first..last``, each clipped to it."""
+    spans = []
+    start = first
+    while start <= last:
+        end = min(month_end(start), last)
+        spans.append((start, end))
+        start = end + dt.timedelta(days=1)
+    return spans
