diff --git a/tally/reports/networth.py b/tally/reports/networth.py
new file mode 100644
index 0000000..518b2b0
--- /dev/null
+++ b/tally/reports/networth.py
@@ -0,0 +1,95 @@
+"""The net worth report: what Assets and Liabilities add up to, month by month.
+
+Net worth on a date is the sum of every posting to ``Assets``,
+``Liabilities`` and their descendants dated on or before it, kept per
+commodity. The report prints it at the end of each month of a range, the
+last row falling on the range's final date.
+
+With a target commodity, each row is converted the way ``balance --convert``
+converts: every posting at the latest direct price on or before the row's
+date, rounded per posting. With ``forecast``, occurrences of periodic
+transactions after the last real transaction count as if they had happened.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+from collections import defaultdict
+from dataclasses import dataclass
+from decimal import Decimal
+
+from tally.accounts import account_matches
+from tally.amounts import ZERO
+from tally.convert import Converter
+from tally.dates import month_spans
+from tally.model import Journal
+from tally.periodic import expand_after
+from tally.reports.columns import quantity_cell
+
+NET_WORTH_ACCOUNTS = ("Assets", "Liabilities")
+
+
+@dataclass(frozen=True)
+class NetWorthRow:
+    date: dt.date
+    amount: Decimal
+    commodity: str = ""
+
+
+def row_dates(first: dt.date, until: dt.date) -> list[dt.date]:
+    """The last day of each month from ``first``'s through ``until``'s; the last is ``until``."""
+    return [end for _, end in month_spans(first.replace(day=1), until)]
+
+
+def first_date(journal: Journal, date_from: dt.date | None, until: dt.date) -> dt.date:
+    """``--from`` if given, else the earliest real transaction (never after ``until``)."""
+    if date_from is not None:
+        return date_from
+    earliest = min((t.date for t in journal.transactions), default=until)
+    return min(earliest, until)
+
+
+def _counts(account: str) -> bool:
+    return any(account_matches(account, root) for root in NET_WORTH_ACCOUNTS)
+
+
+def compute_networth(
+    journal: Journal,
+    dates: list[dt.date],
+    target: str | None = None,
+    forecast: bool = False,
+) -> list[NetWorthRow]:
+    """Net worth per commodity on each date, default commodity first.
+
+    Raises :class:`~tally.convert.ConversionError` for the first row with a
+    posting that has no usable price.
+    """
+    transactions = journal.sorted_transactions()
+    if forecast and dates:
+        last_real = max((t.date for t in journal.transactions), default=None)
+        transactions += expand_after(journal.periodic, last_real, dates[-1])
+    rows: list[NetWorthRow] = []
+    for date in dates:
+        convert = Converter(journal, target, date) if target is not None else None
+        sums: dict[str, Decimal] = defaultdict(lambda: ZERO)
+        for txn in transactions:
+            if txn.date > date:
+                continue
+            for posting in txn.postings:
+                if not _counts(posting.account):
+                    continue
+                if convert is None:
+                    amount, commodity = posting.amount, posting.commodity
+                else:
+                    amount, commodity = convert(posting)
+                sums[commodity] += amount
+        if not sums:
+            sums[""] = ZERO
+        rows.extend(NetWorthRow(date, sums[c], c) for c in sorted(sums))
+    return rows
+
+
+def render_networth(rows: list[NetWorthRow]) -> str:
+    return "\n".join(
+        f"{row.date.isoformat()}  {quantity_cell(row.amount, row.commodity)}" for row in rows
+    )
diff --git a/tests/test_networth.py b/tests/test_networth.py
new file mode 100644
index 0000000..ef9b591
--- /dev/null
+++ b/tests/test_networth.py
@@ -0,0 +1,50 @@
+import datetime as dt
+from decimal import Decimal
+
+from conftest import run_tally
+from tally.parser import parse_text
+from tally.reports.networth import compute_networth, row_dates
+
+JOURNAL = """\
+P 2026-01-31 EUR 1.10 USD
+P 2026-02-28 EUR 1.20 USD
+
+2026-01-05 Salary
+    Assets:Checking  1000.00 USD
+    Income:Salary
+
+2026-01-20 Card
+    Liabilities:Card  -50 EUR
+    Expenses:Food
+
+~ monthly from 2026-01-25 Allowance
+    Assets:Wallet  100 EUR
+    Income:Allowance
+"""
+
+
+def test_row_dates_end_on_until():
+    assert row_dates(dt.date(2026, 1, 15), dt.date(2026, 3, 10)) == [
+        dt.date(2026, 1, 31), dt.date(2026, 2, 28), dt.date(2026, 3, 10),
+    ]
+    assert row_dates(dt.date(2026, 2, 1), dt.date(2026, 2, 28)) == [dt.date(2026, 2, 28)]
+
+
+def test_compute_networth_per_commodity():
+    journal, problems = parse_text(JOURNAL, "j.ledger")
+    assert problems == []
+    rows = compute_networth(journal, [dt.date(2026, 1, 31)])
+    assert [(r.commodity, r.amount) for r in rows] == [("EUR", Decimal("-50")), ("USD", Decimal("1000.00"))]
+
+
+def test_networth_convert_and_forecast(journal):
+    result = run_tally(
+        "networth", journal(JOURNAL), "--until", "2026-02-28", "--convert", "USD", "--forecast"
+    )
+    assert result.returncode == 0, result.stderr
+    # Jan 31: 1000 - 55.00 + 110.00 (allowance on Jan 25, after the last real transaction)
+    # Feb 28: 1000 - 60.00 + 240.00
+    assert result.stdout.splitlines() == [
+        "2026-01-31     1055.00 USD",
+        "2026-02-28     1180.00 USD",
+    ]
