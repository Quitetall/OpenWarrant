diff --git a/tally/convert.py b/tally/convert.py
new file mode 100644
index 0000000..2e15c26
--- /dev/null
+++ b/tally/convert.py
@@ -0,0 +1,62 @@
+"""Converting amounts into one commodity using price directives."""
+
+from __future__ import annotations
+
+import datetime as dt
+from decimal import Decimal
+
+from tally.amounts import round_amount
+from tally.model import Journal, Posting, Price
+
+
+class ConversionError(Exception):
+    """An amount could not be converted because no price applies."""
+
+
+class PriceBook:
+    """Direct prices only: ``P d EUR r USD`` converts EUR to USD, not back."""
+
+    def __init__(self, prices: list[Price]):
+        # Sorted by date with file order kept for ties, so the last match wins.
+        self._prices = sorted(prices, key=lambda p: p.date)
+
+    def rate(self, commodity: str, target: str, on: dt.date) -> Decimal | None:
+        """The latest rate from ``commodity`` to ``target`` dated on or before ``on``."""
+        found = None
+        for price in self._prices:
+            if price.date > on:
+                break
+            if price.commodity == commodity and price.quote == target:
+                found = price.rate
+        return found
+
+
+class Converter:
+    """Converts posting amounts into ``target`` at the prices of one date.
+
+    Each converted posting is rounded to two places, half to even, before it
+    is added to anything. Amounts already in ``target`` and amounts in the
+    default (unnamed) commodity are returned unchanged.
+    """
+
+    def __init__(self, journal: Journal, target: str, at: dt.date):
+        self.book = PriceBook(journal.prices)
+        self.target = target
+        self.at = at
+
+    def __call__(self, posting: Posting) -> tuple[Decimal, str]:
+        if posting.commodity in ("", self.target):
+            return posting.amount, posting.commodity
+        rate = self.book.rate(posting.commodity, self.target, self.at)
+        if rate is None:
+            raise ConversionError(
+                f"no price for {posting.commodity} in {self.target} "
+                f"on or before {self.at.isoformat()}"
+            )
+        return round_amount(posting.amount * rate), self.target
+
+
+def latest_date(journal: Journal) -> dt.date | None:
+    """The latest date of any transaction or price directive."""
+    dates = [t.date for t in journal.transactions] + [p.date for p in journal.prices]
+    return max(dates, default=None)
