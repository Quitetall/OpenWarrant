diff --git a/tests/test_convert.py b/tests/test_convert.py
new file mode 100644
index 0000000..a175e74
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,28 @@
+import datetime as dt
+from decimal import Decimal
+
+from conftest import run_tally
+from tally.convert import PriceBook
+from tally.parser import parse_text
+
+PRICES = """\
+P 2026-01-15 EUR 1.0850 USD
+P 2026-02-01 EUR 1.10 USD
+P 2026-02-01 EUR 1.20 USD
+"""
+
+
+def test_price_book_takes_latest_on_or_before():
+    journal, _ = parse_text(PRICES, "j.ledger")
+    book = PriceBook(journal.prices)
+    assert book.rate("EUR", "USD", dt.date(2026, 1, 31)) == Decimal("1.0850")
+    assert book.rate("EUR", "USD", dt.date(2026, 2, 1)) == Decimal("1.20")
+    assert book.rate("EUR", "USD", dt.date(2026, 1, 14)) is None
+    assert book.rate("USD", "EUR", dt.date(2026, 3, 1)) is None
+
+
+def test_balance_convert(journal):
+    path = journal(PRICES + "\n2026-01-20 Cafe\n    Expenses:Food  10 EUR\n    Assets:Wallet\n")
+    result = run_tally("balance", path, "--convert", "USD", "--at", "2026-01-31")
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines()[:2] == ["    -10.85 USD  Assets:Wallet", "     10.85 USD  Expenses:Food"]
