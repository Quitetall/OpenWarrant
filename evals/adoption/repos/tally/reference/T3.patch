diff --git a/tally/periodic.py b/tally/periodic.py
new file mode 100644
index 0000000..45f2682
--- /dev/null
+++ b/tally/periodic.py
@@ -0,0 +1,70 @@
+"""Periodic transactions and their expansion into dated transactions.
+
+A rule recurs from its start date: ``weekly`` every 7 days, ``monthly`` on
+the same day of each month and ``yearly`` on the same day each year. When a
+month is too short the occurrence falls on its last day, and later
+occurrences return to the original day (Jan 31, Feb 28, Mar 31).
+"""
+
+from __future__ import annotations
+
+import calendar
+import datetime as dt
+from dataclasses import replace
+from typing import Iterator
+
+PERIODS = ("weekly", "monthly", "yearly")
+DEFAULT_DESCRIPTION = "Forecast"
+
+
+def add_months(start: dt.date, months: int) -> dt.date:
+    """``start`` moved by ``months``, clamped to the end of a short month."""
+    year, month0 = divmod(start.month - 1 + months, 12)
+    year += start.year
+    last = calendar.monthrange(year, month0 + 1)[1]
+    return dt.date(year, month0 + 1, min(start.day, last))
+
+
+def nth_occurrence(period: str, start: dt.date, n: int) -> dt.date:
+    if period == "weekly":
+        return start + dt.timedelta(weeks=n)
+    if period == "monthly":
+        return add_months(start, n)
+    if period == "yearly":
+        return add_months(start, 12 * n)
+    raise ValueError(f"unknown period '{period}'")
+
+
+def occurrences(rule, until: dt.date) -> Iterator[dt.date]:
+    """Dates of ``rule`` from its start through ``until`` inclusive."""
+    n = 0
+    while True:
+        date = nth_occurrence(rule.period, rule.start, n)
+        if date > until:
+            return
+        yield date
+        n += 1
+
+
+def instantiate(rule, date: dt.date):
+    """A transaction for one occurrence of ``rule``."""
+    template = rule.template
+    return replace(
+        template,
+        date=date,
+        postings=[replace(p, inferred=False) for p in template.postings],
+    )
+
+
+def expand(rules, until: dt.date) -> list:
+    """Every occurrence of every rule up to ``until``, in date order.
+
+    Occurrences on the same date keep the order of their rules in the file.
+    """
+    dated = [
+        (date, index, rule)
+        for index, rule in enumerate(rules)
+        for date in occurrences(rule, until)
+    ]
+    dated.sort(key=lambda item: (item[0], item[1]))
+    return [instantiate(rule, date) for date, _, rule in dated]
diff --git a/tests/test_periodic.py b/tests/test_periodic.py
new file mode 100644
index 0000000..1f5efba
--- /dev/null
+++ b/tests/test_periodic.py
@@ -0,0 +1,35 @@
+import datetime as dt
+
+from conftest import run_tally
+from tally.parser import parse_text
+from tally.periodic import add_months, expand
+
+
+def test_add_months_clamps_and_recovers():
+    start = dt.date(2026, 1, 31)
+    assert [add_months(start, n) for n in range(4)] == [
+        dt.date(2026, 1, 31), dt.date(2026, 2, 28), dt.date(2026, 3, 31), dt.date(2026, 4, 30),
+    ]
+    assert add_months(dt.date(2024, 2, 29), 12) == dt.date(2025, 2, 28)
+
+
+def test_periodic_rules_are_kept_apart_from_transactions():
+    journal, problems = parse_text(
+        "~ weekly from 2026-01-01 Allowance\n  Expenses:Kids  5\n  Assets:Cash\n", "j.ledger"
+    )
+    assert problems == []
+    assert journal.transactions == []
+    (rule,) = journal.periodic
+    dates = [t.date for t in expand(journal.periodic, dt.date(2026, 1, 15))]
+    assert dates == [dt.date(2026, 1, 1), dt.date(2026, 1, 8), dt.date(2026, 1, 15)]
+    assert rule.template.payee == "Allowance"
+
+
+def test_forecast_command(journal):
+    path = journal("~ monthly from 2026-01-31\n    Expenses:Rent  1200\n    Assets:Checking\n")
+    result = run_tally("forecast", path, "--until", "2026-02-28")
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == (
+        "2026-01-31 Forecast\n    Expenses:Rent  1200.00\n    Assets:Checking  -1200.00\n\n"
+        "2026-02-28 Forecast\n    Expenses:Rent  1200.00\n    Assets:Checking  -1200.00\n"
+    )
