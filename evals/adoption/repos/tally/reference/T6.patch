@@ -24,6 +24,15 @@ def segments(name: str) -> list[str]:
     return name.split(SEPARATOR)
 
 
+def truncate(name: str, depth: int) -> str:
+    """The ancestor of ``name`` with at most ``depth`` segments.
+
+    ``truncate("Expenses:Food:Groceries", 2)`` is ``Expenses:Food``; a name
+    with ``depth`` segments or fewer is returned unchanged.
+    """
+    return SEPARATOR.join(segments(name)[:depth])
+
