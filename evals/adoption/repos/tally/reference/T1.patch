diff --git a/tests/test_commodities.py b/tests/test_commodities.py
new file mode 100644
index 0000000..43b7637
--- /dev/null
+++ b/tests/test_commodities.py
@@ -0,0 +1,51 @@
+from decimal import Decimal
+
+from conftest import run_tally
+from tally.parser import parse_text
+
+
+def parse(text):
+    return parse_text(text, "j.ledger")
+
+
+def test_elided_amount_takes_the_commodity():
+    journal, problems = parse("2026-01-05 A\n  Expenses:Food  10 EUR\n  Assets:Cash\n")
+    assert problems == []
+    posting = journal.transactions[0].postings[1]
+    assert (posting.amount, posting.commodity) == (Decimal("-10"), "EUR")
+
+
+def test_balancing_is_per_commodity():
+    _, problems = parse("2026-01-05 A\n  Assets:Cash  10 EUR\n  Assets:Bank  -10 USD\n")
+    assert [p.message for p in problems] == [
+        "transaction does not balance in EUR (off by 10.00)",
+        "transaction does not balance in USD (off by -10.00)",
+    ]
+
+
+def test_price_directive():
+    journal, problems = parse("P 2026-01-15 EUR 1.0850 USD\n")
+    assert problems == []
+    (price,) = journal.prices
+    assert (price.commodity, price.rate, price.quote) == ("EUR", Decimal("1.0850"), "USD")
+
+
+def test_balance_rows_per_commodity(journal):
+    path = journal(
+        """
+        2026-01-05 Exchange
+            Assets:Wallet  100 EUR
+            Equity:Conversion
+        2026-01-06 Pay
+            Assets:Wallet  20
+            Income:Gift
+        """
+    )
+    result = run_tally("balance", path, "Assets")
+    assert result.stdout.splitlines() == [
+        "         20.00  Assets:Wallet",
+        "    100.00 EUR  Assets:Wallet",
+        "--------------",
+        "         20.00",
+        "    100.00 EUR",
+    ]
