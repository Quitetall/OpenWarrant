 from __future__ import annotations
@@ -13,6 +16,7 @@ CENT = Decimal("0.01")
 ZERO = Decimal("0")
 
 _NUMBER_RE = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)$")
+_COMMODITY_RE = re.compile(r"^[A-Z]{1,10}$")
 
 
 class AmountError(ValueError):
@@ -27,6 +31,23 @@ def parse_amount(text: str) -> Decimal:
     return Decimal(text)
 
 
+def parse_commodity(text: str) -> str:
+    """A commodity code: one to ten uppercase ASCII letters."""
+    if not _COMMODITY_RE.match(text):
+        raise AmountError(f"invalid commodity '{text}'")
+    return text
+
+
+def parse_quantity(text: str) -> tuple[Decimal, str]:
+    """Parse ``NUMBER`` or ``NUMBER COMMODITY`` into (amount, commodity)."""
+    parts = text.split()
+    if len(parts) == 1:
+        return parse_amount(parts[0]), ""
+    if len(parts) == 2:
+        return parse_amount(parts[0]), parse_commodity(parts[1])
+    raise AmountError(f"invalid amount '{text.strip()}'")
+
+
 def round_amount(value: Decimal) -> Decimal:
     """Round to two places, half to even."""
