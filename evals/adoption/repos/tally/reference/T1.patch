+def format_quantity(value: Decimal, commodity: str) -> str:
+    """``42.50 EUR``, or just ``42.50`` for the default commodity."""
+    text = format_amount(value)
+    return f"{text} {commodity}" if commodity else text
+
+
 def total(values) -> Decimal:
     """Sum an iterable of amounts, starting from an exact zero."""
