 AMOUNT_COLUMN = 14
@@ -59,6 +63,25 @@ def compute_budget(journal: Journal, start: dt.date, end: dt.date) -> list[Budge
     ]
 
 
+def month_ranges(start: dt.date, end: dt.date) -> list[tuple[dt.date, dt.date]]:
+    """Calendar months overlapping ``start..end``, each clipped to it."""
+    ranges = []
+    first = start
+    while first <= end:
+        next_month = add_months(first.replace(day=1), 1)
+        last = min(end, next_month - dt.timedelta(days=1))
+        ranges.append((first, last))
+        first = next_month
+    return ranges
+
+
+def compute_monthly_budget(
+    journal: Journal, start: dt.date, end: dt.date
+) -> list[tuple[dt.date, dt.date, list[BudgetRow]]]:
+    """One budget table per month, each month on its own."""
+    return [(first, last, compute_budget(journal, first, last)) for first, last in month_ranges(start, end)]
+
+
 def _row(account: str, *cells: str) -> str:
     return f"{account:<{ACCOUNT_COLUMN}}" + "".join(f"{c:>{AMOUNT_COLUMN}}" for c in cells)
 
@@ -75,3 +98,10 @@ def render_budget(rows: list[BudgetRow]) -> str:
             )
         )
     return "\n".join(lines)
+
+
+def render_monthly_budget(blocks: list[tuple[dt.date, dt.date, list[BudgetRow]]]) -> str:
+    return "\n\n".join(
+        f"{first.isoformat()}..{last.isoformat()}\n{render_budget(rows)}"
+        for first, last, rows in blocks
+    )
