diff --git a/tests/test_costs.py b/tests/test_costs.py
new file mode 100644
index 0000000..3a2b9d9
--- /dev/null
+++ b/tests/test_costs.py
@@ -0,0 +1,56 @@
+from decimal import Decimal
+
+from conftest import run_tally
+from tally.parser import parse_text
+
+JOURNAL = """\
+2026-02-01 Buy shares
+    Assets:Broker  10 AAPL @ 150.00 USD
+    Assets:Checking
+
+2026-02-15 Sell some
+    Assets:Broker  -4 AAPL @ 175 USD
+    Assets:Checking  700 USD
+"""
+
+
+def test_cost_is_per_unit():
+    journal, problems = parse_text(JOURNAL, "j.ledger")
+    assert problems == []
+    buy, sell = journal.transactions
+    assert buy.postings[0].weight() == (Decimal("1500.00"), "USD")
+    assert buy.postings[1].amount == Decimal("-1500.00")
+    assert sell.postings[0].weight() == (Decimal("-700"), "USD")
+
+
+def test_cost_problems():
+    _, problems = parse_text(
+        "2026-01-01 X\n    Assets:A  1 AAPL @ 0 USD\n    Assets:B\n\n"
+        "2026-01-02 Y\n    Assets:A  1 AAPL @ 5 AAPL\n    Assets:B\n",
+        "j.ledger",
+    )
+    assert [p.message for p in problems] == [
+        "invalid cost '0 USD'",
+        "cost must be in a different commodity",
+    ]
+
+
+def test_print_and_balance_cost(journal):
+    path = journal(JOURNAL)
+    printed = run_tally("print", path)
+    assert printed.stdout.splitlines()[1] == "    Assets:Broker  10.00 AAPL @ 150.00 USD"
+    result = run_tally("balance", path, "--cost")
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines()[:2] == [
+        "    800.00 USD  Assets:Broker",
+        "   -800.00 USD  Assets:Checking",
+    ]
+
+
+def test_register_cost(journal):
+    result = run_tally("register", journal(JOURNAL), "Assets:Broker", "--cost")
+    assert result.returncode == 0, result.stderr
+    assert [line.split()[-4:] for line in result.stdout.splitlines()] == [
+        ["1500.00", "USD", "1500.00", "USD"],
+        ["-700.00", "USD", "800.00", "USD"],
+    ]
