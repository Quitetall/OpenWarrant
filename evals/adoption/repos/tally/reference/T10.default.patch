index 2e15c26..2351f5d 100644
--- a/tally/convert.py
+++ b/tally/convert.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 
 import datetime as dt
 from decimal import Decimal
+from typing import Callable
 
 from tally.amounts import round_amount
 from tally.model import Journal, Posting, Price
@@ -45,18 +46,40 @@ class Converter:
         self.at = at
 
     def __call__(self, posting: Posting) -> tuple[Decimal, str]:
-        if posting.commodity in ("", self.target):
-            return posting.amount, posting.commodity
-        rate = self.book.rate(posting.commodity, self.target, self.at)
+        return self.convert(posting.amount, posting.commodity)
+
+    def convert(self, amount: Decimal, commodity: str) -> tuple[Decimal, str]:
+        if commodity in ("", self.target):
+            return amount, commodity
+        rate = self.book.rate(commodity, self.target, self.at)
         if rate is None:
             raise ConversionError(
-                f"no price for {posting.commodity} in {self.target} "
+                f"no price for {commodity} in {self.target} "
                 f"on or before {self.at.isoformat()}"
             )
-        return round_amount(posting.amount * rate), self.target
+        return round_amount(amount * rate), self.target
 
 
 def latest_date(journal: Journal) -> dt.date | None:
     """The latest date of any transaction or price directive."""
     dates = [t.date for t in journal.transactions] + [p.date for p in journal.prices]
     return max(dates, default=None)
+
+
+def valuation(
+    at_cost: bool, converter: Converter | None
+) -> Callable[[Posting], tuple[Decimal, str]] | None:
+    """How a report values each posting: its weight with ``--cost``, then converted.
+
+    Returns None when the posting's own amount is used as it is.
+    """
+    if not at_cost and converter is None:
+        return None
+
+    def value(posting: Posting) -> tuple[Decimal, str]:
+        amount, commodity = posting.weight() if at_cost else (posting.amount, posting.commodity)
+        if converter is None:
+            return amount, commodity
+        return converter.convert(amount, commodity)
+
+    return value
