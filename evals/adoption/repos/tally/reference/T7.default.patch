diff --git a/tally/reports/export.py b/tally/reports/export.py
new file mode 100644
index 0000000..a0c6922
--- /dev/null
+++ b/tally/reports/export.py
@@ -0,0 +1,40 @@
+"""The export report: every posting as one row of delimited text.
+
+The file is meant for a spreadsheet: a header row, then one row per posting
+of each real transaction in ``print`` order, elided amounts filled in.
+Fields are separated by ``,`` and amounts use a decimal point (``-42.50``).
+A field is quoted only when it contains the separator or a double quote.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+
+from tally.accounts import account_matches
+from tally.amounts import format_amount
+from tally.model import Journal
+
+SEPARATOR = ","
+DECIMAL_MARK = "."
+HEADER = ("date", "payee", "account", "amount", "commodity")
+
+
+def compute_export(journal: Journal, account: str | None = None) -> list[tuple[str, ...]]:
+    """One tuple of field texts per posting, in ``print`` order."""
+    rows: list[tuple[str, ...]] = []
+    for txn in journal.sorted_transactions():
+        for posting in txn.postings:
+            if account is not None and not account_matches(posting.account, account):
+                continue
+            amount = format_amount(posting.amount).replace(".", DECIMAL_MARK)
+            rows.append((txn.date.isoformat(), txn.payee, posting.account, amount, posting.commodity))
+    return rows
+
+
+def render_export(rows: list[tuple[str, ...]]) -> str:
+    out = io.StringIO()
+    writer = csv.writer(out, delimiter=SEPARATOR, lineterminator="\n", quoting=csv.QUOTE_MINIMAL)
+    writer.writerow(HEADER)
+    writer.writerows(rows)
+    return out.getvalue()
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..db2b2af
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,28 @@
+from conftest import run_tally
+
+JOURNAL = """\
+2026-01-05 Corner Grocery
+    Expenses:Food  42.50
+    Assets:Checking
+
+2026-01-06 Smith, Jones
+    Expenses:Travel  10 EUR
+    Assets:Wallet
+"""
+
+
+def test_export(journal):
+    result = run_tally("export", journal(JOURNAL))
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == (
+        "date,payee,account,amount,commodity\n"
+        "2026-01-05,Corner Grocery,Expenses:Food,42.50,\n"
+        "2026-01-05,Corner Grocery,Assets:Checking,-42.50,\n"
+        "2026-01-06,\"Smith, Jones\",Expenses:Travel,10.00,EUR\n"
+        "2026-01-06,\"Smith, Jones\",Assets:Wallet,-10.00,EUR\n"
+    )
+
+
+def test_export_account_filter(journal):
+    result = run_tally("export", journal(JOURNAL), "Assets:Wallet")
+    assert result.stdout.splitlines()[1:] == ["2026-01-06,\"Smith, Jones\",Assets:Wallet,-10.00,EUR"]
