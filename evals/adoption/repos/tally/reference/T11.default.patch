+
+
+def drop_duplicates(
+    transactions: list[Transaction], journal: Journal, rules: Rules
+) -> tuple[list[Transaction], int]:
+    """Leave out the imported transactions ``journal`` already records.
+
+    A row is a duplicate when the journal has a posting to the rules'
+    ``account`` with the row's date, amount and commodity. Rows claim
+    postings in CSV order; each journal posting is claimed at most once, the
+    earliest in the journal first. Returns the kept transactions and the
+    number left out.
+    """
+    candidates = [
+        (txn.date, posting)
+        for txn in journal.transactions
+        for posting in txn.postings
+        if posting.account == rules.account
+    ]
+    used: set[int] = set()
+    kept: list[Transaction] = []
+    for txn in transactions:
+        mine = txn.postings[1]
+        match = next(
+            (
+                index for index, (date, posting) in enumerate(candidates)
+                if index not in used
+                and date == txn.date
+                and posting.amount == mine.amount
+                and posting.commodity == mine.commodity
+            ),
+            None,
+        )
+        if match is None:
+            kept.append(txn)
+        else:
+            used.add(match)
+    return kept, len(transactions) - len(kept)
