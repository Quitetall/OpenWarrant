+    /// Count legal move paths of exactly `depth` plies by the rules of movement
+    /// alone. Draw and dead-position adjudication are deliberately ignored.
+    pub fn perft(&self, depth: u32) -> u64 {
+        perft_board(&self.board, depth)
+    }
+
+    /// Per-root-move perft counts keyed by standard UCI (castling as `e1g1`).
+    pub fn perft_divide(&self, depth: u32) -> BTreeMap<String, u64> {
+        let mut divide = BTreeMap::new();
+        if depth == 0 {
+            return divide;
+        }
+        for mv in self.internal_moves() {
+            let mut child = self.board.clone();
+            child.play_unchecked(mv);
+            divide.insert(
+                cozy_chess::util::display_uci_move(&self.board, mv).to_string(),
+                perft_board(&child, depth - 1),
+            );
+        }
+        divide
+    }
+
