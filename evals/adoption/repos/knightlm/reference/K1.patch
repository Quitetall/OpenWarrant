+#[test]
+fn perft_matches_published_counts_and_ignores_adjudication() {
+    let s = start();
+    assert_eq!(
+        (0..=3).map(|d| s.perft(d)).collect::<Vec<_>>(),
+        [1, 20, 400, 8902]
+    );
+    let divide = s.perft_divide(2);
+    assert_eq!(divide.len(), 20);
+    assert!(divide.values().all(|&n| n == 20));
+    let dead = setup("8/8/4k3/8/8/2B5/8/4K3 w - - 0 1", true);
+    assert_eq!(
+        dead.facts().terminal_reason.as_deref(),
+        Some("proven_dead_position")
+    );
+    assert!(dead.legal_moves().is_empty());
+    assert_eq!(dead.perft(1), 15);
+}
