@@ -419,3 +419,26 @@ fn same_coloured_bishops_are_dead_and_other_minors_stay_unknown() {
         assert_eq!(s.facts().terminal_reason, None, "{fen}");
     }
 }
+
+#[test]
+fn san_disambiguates_among_legal_moves_and_marks_check_and_mate() {
+    let s = setup("4k3/8/8/8/8/Q7/8/Q1Q1K3 w - - 0 1", true);
+    assert_eq!(s.san("a1b2").unwrap(), "Qa1b2");
+    let s = setup("k3r3/8/8/1N6/8/8/4N3/4K3 w - - 0 1", true);
+    assert_eq!(s.san("b5c3").unwrap(), "Nc3"); // e2 is pinned
+    let castle = setup("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", true);
+    assert_eq!(castle.san("e1g1").unwrap(), "O-O");
+    assert_eq!(castle.san("e1c1").unwrap(), "O-O-O");
+    let mut fool = start();
+    for m in ["f2f3", "e7e5", "g2g4"] {
+        fool.play(m).unwrap();
+    }
+    assert_eq!(fool.san("d8h4").unwrap(), "Qh4#");
+    assert!(fool.san("d8d1").is_err());
+    let packet = start().compile(PacketOptions {
+        legal_choices: true,
+        legal_san: true,
+        ..Default::default()
+    });
+    assert_eq!(packet.legal_moves_san.unwrap()[..3], ["a3", "a4", "Na3"]);
+}
