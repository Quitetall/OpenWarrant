@@ -0,0 +1,12 @@
+//! Standard Algebraic Notation rendering for legal moves of a position.
+use anyhow::{Context, Result, ensure};
+use cozy_chess::Board;
+
+/// Render a legal standard-UCI move (castling as `e1g1`) as SAN: piece letter,
+/// minimal file/rank disambiguation among legal moves, `x` for captures,
+/// `=Q` promotions, `O-O`/`O-O-O`, then `+` for check or `#` for mate.
+pub fn uci_to_san(board: &Board, uci: &str) -> Result<String> {
+    let mv = cozy_chess::util::parse_uci_move(board, uci).context("malformed UCI move")?;
+    ensure!(board.is_legal(mv), "illegal move: {uci}");
+    Ok(cozy_chess::util::display_san_move(board, mv).to_string())
+}
