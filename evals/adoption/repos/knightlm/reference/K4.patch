index c9520e1..0a5ff7e 100644
--- a/crates/core/src/san.rs
+++ b/crates/core/src/san.rs
@@ -10,3 +10,20 @@ pub fn uci_to_san(board: &Board, uci: &str) -> Result<String> {
     ensure!(board.is_legal(mv), "illegal move: {uci}");
     Ok(cozy_chess::util::display_san_move(board, mv).to_string())
 }
+
+/// Resolve a SAN token to exactly one legal move, returned as standard UCI.
+/// Trailing `!`/`?` annotations and `+`/`#` are ignored, `0-0` is read as
+/// `O-O`, and over-specified disambiguation is accepted when it is unique.
+pub fn san_to_uci(board: &Board, token: &str) -> Result<String> {
+    let mut san = token.trim_end_matches(['!', '?']).to_owned();
+    for (zeros, letters) in [("0-0-0", "O-O-O"), ("0-0", "O-O")] {
+        if let Some(rest) = san.strip_prefix(zeros) {
+            san = format!("{letters}{rest}");
+            break;
+        }
+    }
+    let mv = cozy_chess::util::parse_san_move(board, &san)
+        .ok()
+        .context("no unique legal move")?;
+    Ok(cozy_chess::util::display_uci_move(board, mv).to_string())
+}
diff --git a/crates/core/src/state.rs b/crates/core/src/state.rs
