@@ -210,6 +210,21 @@ impl GameState {
         crate::san::uci_to_san(&self.board, uci)
     }
 
+    /// Play one SAN token. Errors name the move number and side to move.
+    pub fn play_san(&mut self, token: &str) -> Result<String> {
+        let side = match self.board.side_to_move() {
+            Color::White => "white",
+            Color::Black => "black",
+        };
+        let label = format!(
+            "move {} ({side}): illegal or ambiguous SAN {token:?}",
+            self.fullmove
+        );
+        let uci = crate::san::san_to_uci(&self.board, token).context(label.clone())?;
+        self.play(&uci).context(label)?;
+        Ok(uci)
+    }
+
     pub fn is_legal(&self, uci: &str) -> bool {
         self.facts().terminal_reason.is_none()
             && cozy_chess::util::parse_uci_move(&self.board, uci)
