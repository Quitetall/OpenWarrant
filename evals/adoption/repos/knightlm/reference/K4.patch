index 0000000..d6df6eb
--- /dev/null
+++ b/crates/core/src/pgn.rs
@@ -0,0 +1,168 @@
+//! PGN import into normalized `GameRecord`s. Comments, NAGs and variations are
+//! skipped; only the main line is kept. Provenance comes from the file and tags.
+use anyhow::{Context, Result, bail, ensure};
+
+use crate::SCHEMA_VERSION;
+use crate::state::{GameRecord, GameState, START_FEN};
+
+const TERMINATIONS: [&str; 4] = ["1-0", "0-1", "1/2-1/2", "*"];
+
+/// One game's tag pairs (in file order) and main-line SAN tokens.
+#[derive(Debug, Clone, Default)]
+pub struct PgnGame {
+    pub tags: Vec<(String, String)>,
+    pub moves: Vec<String>,
+    pub termination: String,
+}
+
+impl PgnGame {
+    pub fn tag(&self, name: &str) -> Option<&str> {
+        self.tags
+            .iter()
+            .rev()
+            .find(|(k, _)| k == name)
+            .map(|(_, v)| v.as_str())
+    }
+}
+
+/// Split PGN text into games. Every game must end with a termination marker.
+pub fn parse_games(text: &str) -> Result<Vec<PgnGame>> {
+    let mut games = Vec::new();
+    let mut game = PgnGame::default();
+    let mut started = false;
+    let mut depth = 0usize;
+    let mut chars = text.chars().peekable();
+    let mut at_line_start = true;
+    while let Some(c) = chars.next() {
+        let line_start = at_line_start;
+        at_line_start = c == '\n';
+        match c {
+            c if c.is_whitespace() => {}
+            '%' if line_start => {
+                for c in chars.by_ref() {
+                    if c == '\n' {
+                        at_line_start = true;
+                        break;
+                    }
+                }
+            }
+            ';' => {
+                for c in chars.by_ref() {
+                    if c == '\n' {
+                        at_line_start = true;
+                        break;
+                    }
+                }
+            }
+            '{' => {
+                chars
+                    .by_ref()
+                    .find(|&c| c == '}')
+                    .context("unterminated comment")?;
+            }
+            '(' => depth += 1,
+            ')' => depth = depth.checked_sub(1).context("unbalanced variation")?,
+            '[' if depth == 0 => {
+                let mut tag = String::new();
+                let mut value = None;
+                loop {
+                    match chars.next().context("unterminated tag pair")? {
+                        ']' => break,
+                        '"' => {
+                            let mut v = String::new();
+                            loop {
+                                match chars.next().context("unterminated tag value")? {
+                                    '"' => break,
+                                    '\\' => v.push(chars.next().context("unterminated tag value")?),
+                                    c => v.push(c),
+                                }
+                            }
+                            value = Some(v);
+                        }
+                        c if value.is_none() => tag.push(c),
+                        c if c.is_whitespace() => {}
+                        _ => bail!("malformed tag pair"),
+                    }
+                }
+                let name = tag.trim().to_owned();
+                ensure!(!name.is_empty(), "malformed tag pair");
+                game.tags
+                    .push((name, value.context("tag pair without a value")?));
+                started = true;
+            }
+            _ => {
+                let mut token = String::from(c);
+                while let Some(&n) = chars.peek() {
+                    if n.is_whitespace() || "{}()[];".contains(n) {
+                        break;
+                    }
+                    token.push(n);
+                    chars.next();
+                }
+                if depth > 0 || token.starts_with('$') {
+                    continue;
+                }
+                started = true;
+                if TERMINATIONS.contains(&token.as_str()) {
+                    game.termination = token;
+                    games.push(std::mem::take(&mut game));
+                    started = false;
+                    continue;
+                }
+                // Strip move numbers such as `12.`, `12...` and `1.e4`.
+                let san = match token.rfind('.') {
+                    None => token.as_str(),
+                    Some(i) if token[..i].chars().all(|c| c.is_ascii_digit() || c == '.') => {
+                        &token[i + 1..]
+                    }
+                    Some(_) => bail!("unexpected token {token:?}"),
+                };
+                if !san.is_empty() {
+                    game.moves.push(san.to_owned());
+                }
+            }
+        }
+    }
+    ensure!(depth == 0, "unbalanced variation");
+    ensure!(!started, "missing game termination marker");
+    ensure!(!games.is_empty(), "no games in PGN file");
+    Ok(games)
+}
+
+/// Import game `index` (1-based) of a PGN file into a normalized record.
+pub fn import(text: &str, file_name: &str, index: usize) -> Result<GameRecord> {
+    let games = parse_games(text)?;
+    ensure!(
+        (1..=games.len()).contains(&index),
+        "PGN file contains {} games; --game {index} is out of range",
+        games.len()
+    );
+    let game = &games[index - 1];
+    if let Some(result) = game.tag("Result") {
+        ensure!(
+            result == game.termination,
+            "Result tag {result:?} disagrees with termination marker {:?}",
+            game.termination
+        );
+    }
+    let reference = format!("{file_name}#{index}");
+    let fen = game.tag("FEN");
+    let game_id = match game.tag("Site") {
+        Some(site) if !site.trim().is_empty() && site != "?" => site.to_owned(),
+        _ => reference.clone(),
+    };
+    let mut state = GameState::replay(&GameRecord {
+        schema_version: SCHEMA_VERSION,
+        game_id,
+        source: format!("pgn:{reference}"),
+        initial_fen: fen.unwrap_or(START_FEN).to_owned(),
+        // A setup position never proves the history before it.
+        history_complete: fen.is_none(),
+        moves: vec![],
+    })
+    .context("invalid FEN tag")?;
+    for token in &game.moves {
+        state.play_san(token)?;
+    }
+    Ok(state.record().clone())
+}
