+
+#[test]
+fn pgn_import_keeps_main_line_and_never_asserts_setup_history() {
+    let text = "[Site \"?\"]\n[Result \"*\"]\n\n1. e4 {c} e5 (1... c5 2. Nf3) 2. Nf3 $1 Nc6 *\n\n\
+                [FEN \"4k3/8/8/8/8/8/4P3/4K3 b - - 0 9\"]\n\n9... Kd7 10. e4 *\n";
+    let first = knightlm_core::pgn::import(text, "t.pgn", 1).unwrap();
+    assert_eq!(first.moves, ["e2e4", "e7e5", "g1f3", "b8c6"]);
+    assert_eq!(first.game_id, "t.pgn#1");
+    assert!(first.history_complete);
+    let second = knightlm_core::pgn::import(text, "t.pgn", 2).unwrap();
+    assert!(!second.history_complete);
+    assert_eq!(second.moves, ["e8d7", "e2e4"]);
+    let err = knightlm_core::pgn::import("1. e4 e5 2. Ke3 *", "t.pgn", 1).unwrap_err();
+    assert_eq!(
+        err.to_string(),
+        "move 2 (white): illegal or ambiguous SAN \"Ke3\""
+    );
+    assert!(knightlm_core::pgn::import(text, "t.pgn", 3).is_err());
+}
