index 0000000..3f63cb2
--- /dev/null
+++ b/crates/core/src/tree.rs
@@ -0,0 +1,140 @@
+//! Opening tree: how often each main-line move sequence occurs across the games
+//! of one PGN file, with the termination markers of the games behind it.
+//! Nodes are move sequences, not positions: transpositions stay separate.
+use anyhow::{Result, ensure};
+use serde::Serialize;
+
+use crate::state::GameState;
+
+/// Deepest opening tree that may be requested, in plies.
+pub const MAX_TREE_PLIES: usize = 12;
+
+/// Games behind a node, counted by their PGN termination marker.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+pub struct ResultCounts {
+    #[serde(rename = "1-0")]
+    pub white_wins: u32,
+    #[serde(rename = "0-1")]
+    pub black_wins: u32,
+    #[serde(rename = "1/2-1/2")]
+    pub draws: u32,
+    #[serde(rename = "*")]
+    pub unfinished: u32,
+}
+
+impl ResultCounts {
+    fn add(&mut self, termination: &str) {
+        match termination {
+            "1-0" => self.white_wins += 1,
+            "0-1" => self.black_wins += 1,
+            "1/2-1/2" => self.draws += 1,
+            _ => self.unfinished += 1,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct TreeNode {
+    pub san: String,
+    pub uci: String,
+    /// The current FEN after this node's move sequence, as `compile` reports it.
+    pub fen: String,
+    pub count: u32,
+    pub results: ResultCounts,
+    pub moves: Vec<TreeNode>,
+    /// 1-based index of the earliest game in the file that reaches this node.
+    #[serde(skip)]
+    pub first_game: usize,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct OpeningTree {
+    /// Games that contribute to the tree (every game without a `FEN` tag).
+    pub games: u32,
+    /// Games left out because they start from a setup position.
+    pub skipped_setup: u32,
+    pub plies: usize,
+    pub min_count: u32,
+    pub moves: Vec<TreeNode>,
+}
+
+/// Build the opening tree of a PGN file down to `plies` plies, leaving out
+/// nodes reached by fewer than `min_count` games (and everything below them).
+/// Every game is imported with the `import-pgn` rules; one that fails refuses
+/// the file.
+pub fn opening_tree(
+    text: &str,
+    file_name: &str,
+    plies: usize,
+    min_count: u32,
+) -> Result<OpeningTree> {
+    ensure!(
+        (1..=MAX_TREE_PLIES).contains(&plies),
+        "--plies must be between 1 and {MAX_TREE_PLIES}"
+    );
+    ensure!(min_count >= 1, "--min-count must be at least 1");
+    let mut tree = OpeningTree {
+        games: 0,
+        skipped_setup: 0,
+        plies,
+        min_count,
+        moves: Vec::new(),
+    };
+    for (index, (game, record)) in crate::pgn::import_all(text, file_name)?
+        .into_iter()
+        .enumerate()
+    {
+        if game.tag("FEN").is_some() {
+            tree.skipped_setup += 1;
+            continue;
+        }
+        tree.games += 1;
+        let mut state = GameState::replay(&crate::state::GameRecord {
+            moves: vec![],
+            ..record.clone()
+        })?;
+        let mut level = &mut tree.moves;
+        for uci in record.moves.iter().take(plies) {
+            let san = state.san(uci)?;
+            state.play(uci)?;
+            let at = match level.iter().position(|node| &node.uci == uci) {
+                Some(at) => at,
+                None => {
+                    level.push(TreeNode {
+                        san,
+                        uci: uci.clone(),
+                        fen: state.fen(),
+                        count: 0,
+                        results: ResultCounts::default(),
+                        moves: Vec::new(),
+                        first_game: index + 1,
+                    });
+                    level.len() - 1
+                }
+            };
+            let node = &mut level[at];
+            node.count += 1;
+            node.results.add(&game.termination);
+            level = &mut node.moves;
+        }
+    }
+    prune(&mut tree.moves, min_count);
+    sort_siblings(&mut tree.moves);
+    Ok(tree)
+}
+
+fn prune(nodes: &mut Vec<TreeNode>, min_count: u32) {
+    nodes.retain(|node| node.count >= min_count);
+    for node in nodes {
+        prune(&mut node.moves, min_count);
+    }
+}
+
+/// Most frequent first; equal counts keep the order of first appearance in
+/// the file (the earliest game reaching the move comes first).
+fn sort_siblings(nodes: &mut [TreeNode]) {
+    nodes.sort_by(|a, b| b.count.cmp(&a.count).then(a.first_game.cmp(&b.first_game)));
+    for node in nodes {
+        sort_siblings(&mut node.moves);
+    }
+}
diff --git a/crates/core/tests/contracts.rs b/crates/core/tests/contracts.rs
index f8d600d..26f40ba 100644
--- a/crates/core/tests/contracts.rs
+++ b/crates/core/tests/contracts.rs
@@ -551,3 +551,53 @@ fn encoding_lists_squares_in_fen_reading_order_and_mirrors_when_relative() {
         knightlm_core::encode::encode(&start(), false).squares
     });
 }
+
+#[test]
+fn opening_tree_counts_lines_and_orders_ties_by_first_appearance() {
+    let text = std::fs::read_to_string(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../fixtures/openings.pgn"
+    ))
+    .unwrap();
+    let tree = knightlm_core::tree::opening_tree(&text, "openings.pgn", 2, 1).unwrap();
+    assert_eq!((tree.games, tree.skipped_setup, tree.plies), (3, 1, 2));
+    let first: Vec<_> = tree
+        .moves
+        .iter()
+        .map(|n| (n.san.as_str(), n.count))
+        .collect();
+    assert_eq!(first, [("e4", 2), ("d4", 1)]);
+    let e4 = &tree.moves[0];
+    assert_eq!(e4.uci, "e2e4");
+    assert_eq!(
+        (
+            e4.results.white_wins,
+            e4.results.black_wins,
+            e4.results.draws
+        ),
+        (1, 1, 0)
+    );
+    // e5 (game 1) and c5 (game 3) tie: the earlier game's move comes first.
+    let replies: Vec<_> = e4.moves.iter().map(|n| n.san.as_str()).collect();
+    assert_eq!(replies, ["e5", "c5"]);
+    assert!(e4.moves.iter().all(|n| n.moves.is_empty()));
+    assert_eq!(
+        e4.moves[0].fen,
+        "rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQKBNR w KQkq e6 0 2"
+    );
+    for plies in [0, knightlm_core::tree::MAX_TREE_PLIES + 1] {
+        assert!(knightlm_core::tree::opening_tree(&text, "openings.pgn", plies, 1).is_err());
+    }
+    let common = knightlm_core::tree::opening_tree(&text, "openings.pgn", 2, 2).unwrap();
+    assert_eq!(common.moves.len(), 1);
+    assert_eq!(common.moves[0].san, "e4");
+    assert!(common.moves[0].moves.is_empty());
+    assert!(knightlm_core::tree::opening_tree(&text, "openings.pgn", 2, 0).is_err());
+    let err = knightlm_core::tree::opening_tree("1. e4 *\n\n1. Ke2 *\n", "bad.pgn", 4, 1)
+        .unwrap_err()
+        .to_string();
+    assert!(
+        err.starts_with("game 2: move 1 (white): illegal or ambiguous SAN"),
+        "{err}"
+    );
+}
