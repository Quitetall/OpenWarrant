+
+#[test]
+fn observation_mismatches_are_listed_per_square_and_malformed_input_refused() {
+    let s = start();
+    let o = |placement: &str| BoardObservation {
+        schema_version: 1,
+        image_id: "board.png".into(),
+        placement: placement.into(),
+    };
+    let found = s
+        .observation_mismatches(&o("rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR"))
+        .unwrap();
+    assert_eq!(
+        found,
+        [
+            SquareMismatch {
+                square: "e2".into(),
+                expected: Some('P'),
+                observed: None
+            },
+            SquareMismatch {
+                square: "e4".into(),
+                expected: None,
+                observed: Some('P')
+            },
+        ]
+    );
+    for bad in [
+        "8/8/8/8/8/8/8",
+        "9/8/8/8/8/8/8/8",
+        "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNX",
+    ] {
+        let err = s.observation_mismatches(&o(bad)).unwrap_err();
+        assert_eq!(err.to_string(), "malformed observation placement", "{bad}");
+    }
+}
