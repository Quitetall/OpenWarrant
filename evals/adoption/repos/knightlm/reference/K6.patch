+/// One square where an observation disagrees with the authoritative ledger.
+/// Pieces are FEN letters; `None` is an empty square.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SquareMismatch {
+    pub square: String,
+    pub expected: Option<char>,
+    pub observed: Option<char>,
+}
+
+/// FEN piece placement as 64 squares indexed a1 = 0 ... h8 = 63.
+fn parse_placement(placement: &str) -> Result<[Option<char>; 64]> {
+    let ranks: Vec<_> = placement.split('/').collect();
+    ensure!(ranks.len() == 8, "placement needs eight ranks");
+    let mut squares = [None; 64];
+    for (row, rank) in ranks.iter().enumerate() {
+        let mut file = 0;
+        for c in rank.chars() {
+            match c {
+                '1'..='8' => file += c as usize - '0' as usize,
+                'p' | 'n' | 'b' | 'r' | 'q' | 'k' | 'P' | 'N' | 'B' | 'R' | 'Q' | 'K' => {
+                    ensure!(file < 8, "rank has more than eight squares");
+                    squares[(7 - row) * 8 + file] = Some(c);
+                    file += 1;
+                }
+                _ => bail!("invalid placement character {c:?}"),
+            }
+        }
+        ensure!(file == 8, "rank does not have eight squares");
+    }
+    Ok(squares)
+}
