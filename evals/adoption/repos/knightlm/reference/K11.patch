index 0000000..52b3164
--- /dev/null
+++ b/crates/core/src/suite.rs
@@ -0,0 +1,129 @@
+//! Perft suites: EPD-style lines of positions with published node counts,
+//! checked with the same move counter as `perft` (no draw adjudication).
+use anyhow::{Context, Result, bail, ensure};
+use serde::Serialize;
+
+use crate::SCHEMA_VERSION;
+use crate::state::{GameRecord, GameState, MAX_PERFT_DEPTH};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SuiteResult {
+    /// 1-based line number in the suite file.
+    pub line: usize,
+    pub fen: String,
+    pub depth: u32,
+    pub expected: u64,
+    pub nodes: u64,
+    pub pass: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SuiteReport {
+    pub positions: usize,
+    pub checked: usize,
+    pub passed: usize,
+    pub failed: usize,
+    pub skipped: usize,
+    pub results: Vec<SuiteResult>,
+}
+
+/// Check every `;D<depth> <count>` entry of a suite up to `max_depth`;
+/// deeper entries are skipped. Any malformed line refuses the whole suite.
+pub fn run_suite(text: &str, max_depth: u32) -> Result<SuiteReport> {
+    ensure!(
+        (1..=MAX_PERFT_DEPTH).contains(&max_depth),
+        "--max-depth must be between 1 and {MAX_PERFT_DEPTH}"
+    );
+    let mut lines = Vec::new();
+    for (i, raw) in text.lines().enumerate() {
+        let line = raw.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        lines.push((
+            i + 1,
+            parse_line(line).map_err(|e| anyhow::anyhow!("line {}: {e:#}", i + 1))?,
+        ));
+    }
+    ensure!(!lines.is_empty(), "no positions in perft suite");
+    let mut report = SuiteReport {
+        positions: lines.len(),
+        checked: 0,
+        passed: 0,
+        failed: 0,
+        skipped: 0,
+        results: Vec::new(),
+    };
+    for (line, (state, entries)) in lines {
+        for (depth, expected) in entries {
+            if depth > max_depth {
+                report.skipped += 1;
+                continue;
+            }
+            let nodes = state.perft(depth);
+            report.checked += 1;
+            if nodes == expected {
+                report.passed += 1;
+            } else {
+                report.failed += 1;
+            }
+            report.results.push(SuiteResult {
+                line,
+                fen: state.fen(),
+                depth,
+                expected,
+                nodes,
+                pass: nodes == expected,
+            });
+        }
+    }
+    Ok(report)
+}
+
+type Entries = Vec<(u32, u64)>;
+
+/// `<four or six FEN fields> ;D1 <count> ;D2 <count> ...`
+fn parse_line(line: &str) -> Result<(GameState, Entries)> {
+    let mut parts = line.split(';');
+    let position: Vec<_> = parts
+        .next()
+        .unwrap_or_default()
+        .split_whitespace()
+        .collect();
+    let fen = match position.len() {
+        4 => format!("{} 0 1", position.join(" ")),
+        6 => position.join(" "),
+        n => bail!("position needs four or six FEN fields, found {n}"),
+    };
+    let state = GameState::replay(&GameRecord {
+        schema_version: SCHEMA_VERSION,
+        game_id: "perft-suite".into(),
+        source: "perft suite line".into(),
+        initial_fen: fen,
+        history_complete: false,
+        moves: vec![],
+    })
+    .context("invalid position")?;
+    let mut entries: Entries = Vec::new();
+    for entry in parts {
+        let fields: Vec<_> = entry.split_whitespace().collect();
+        let [label, count] = fields[..] else {
+            bail!("malformed entry {:?}", entry.trim());
+        };
+        let depth = label
+            .strip_prefix('D')
+            .and_then(|d| d.parse::<u32>().ok())
+            .filter(|&d| d >= 1)
+            .with_context(|| format!("malformed depth {label:?}"))?;
+        let count = count
+            .parse::<u64>()
+            .with_context(|| format!("malformed node count {count:?}"))?;
+        ensure!(
+            entries.iter().all(|&(d, _)| d != depth),
+            "depth {depth} listed twice"
+        );
+        entries.push((depth, count));
+    }
+    ensure!(!entries.is_empty(), "no ;D entries");
+    Ok((state, entries))
+}
diff --git a/crates/core/tests/contracts.rs b/crates/core/tests/contracts.rs
index 97ff6ae..64be09f 100644
--- a/crates/core/tests/contracts.rs
+++ b/crates/core/tests/contracts.rs
@@ -663,3 +663,38 @@ fn extract_starts_from_a_stated_position_and_never_claims_history() {
         assert!(err.to_string().starts_with("ply range out of bounds"));
     }
 }
+
+#[test]
+fn perft_suite_checks_published_counts_and_refuses_malformed_lines() {
+    let text = std::fs::read_to_string(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../fixtures/perft-suite.epd"
+    ))
+    .unwrap();
+    let report = knightlm_core::suite::run_suite(&text, 2).unwrap();
+    assert_eq!(
+        (
+            report.positions,
+            report.checked,
+            report.passed,
+            report.skipped
+        ),
+        (4, 8, 8, 2)
+    );
+    assert_eq!(report.results[0].fen, START_FEN);
+    assert_eq!(report.results[0].line, 2);
+    let wrong = knightlm_core::suite::run_suite("8/8/8/8/8/8/8/K6k w - - ;D1 4\n", 6).unwrap();
+    assert_eq!((wrong.failed, wrong.results[0].nodes), (1, 3));
+    for bad in [
+        "8/8/8/8/8/8/8/K6k w - - ;D1\n",
+        "8/8/8/8/8/8/8/K6k w - -\n",
+        "8/8/8/8/8/8/8/K6k w - - ;D0 1\n",
+        "8/8/8/8/8/8/8/K6k w - - ;D1 3 ;D1 3\n",
+        "8/8/8/8/8/8/8/K6k w - ;D1 3\n",
+        "# only a comment\n",
+    ] {
+        assert!(knightlm_core::suite::run_suite(bad, 6).is_err(), "{bad}");
+    }
+    assert!(knightlm_core::suite::run_suite(&text, 0).is_err());
+    assert!(knightlm_core::suite::run_suite(&text, MAX_PERFT_DEPTH + 1).is_err());
+}
