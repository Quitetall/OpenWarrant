diff --git a/crates/core/tests/contracts.rs b/crates/core/tests/contracts.rs
index d8f1511..0abd90b 100644
--- a/crates/core/tests/contracts.rs
+++ b/crates/core/tests/contracts.rs
@@ -396,3 +396,26 @@ fn perft_matches_published_counts_and_ignores_adjudication() {
     assert!(dead.legal_moves().is_empty());
     assert_eq!(dead.perft(1), 15);
 }
+
+#[test]
+fn same_coloured_bishops_are_dead_and_other_minors_stay_unknown() {
+    for fen in [
+        "8/8/4k3/8/8/2B5/8/4K3 w - - 0 1",
+        "8/4b3/4k3/8/8/2B5/8/4K3 w - - 0 1", // e7 and c3 are both dark
+        "8/8/4k3/8/8/2B5/1B6/4K3 b - - 0 1",
+    ] {
+        let s = setup(fen, true);
+        assert_eq!(s.facts().dead_position, Some(true), "{fen}");
+        assert!(s.legal_moves().is_empty(), "{fen}");
+    }
+    for fen in [
+        "8/5b2/4k3/8/8/2B5/8/4K3 w - - 0 1", // f7 light, c3 dark
+        "8/8/4k3/8/8/2B5/2B5/4K3 w - - 0 1",
+        "8/8/4k3/8/8/2N5/2N5/4K3 w - - 0 1",
+        "8/5n2/4k3/8/8/2B5/8/4K3 w - - 0 1",
+    ] {
+        let s = setup(fen, true);
+        assert_eq!(s.facts().dead_position, None, "{fen}");
+        assert_eq!(s.facts().terminal_reason, None, "{fen}");
+    }
+}
