diff --git a/crates/core/src/audit.rs b/crates/core/src/audit.rs
new file mode 100644
index 0000000..5ed817b
--- /dev/null
+++ b/crates/core/src/audit.rs
@@ -0,0 +1,140 @@
+//! PGN file audit: import every game independently and check each game's
+//! termination marker against what its final position establishes.
+use anyhow::Result;
+use serde::Serialize;
+
+use crate::pgn::{PgnGame, computed_result, import_game, parse_games};
+use crate::state::{GameRecord, GameState};
+
+/// One game's audit. Every field except `index`, `termination` and `error` is
+/// `None` when the game could not be imported.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct GameAudit {
+    pub index: usize,
+    pub game_id: Option<String>,
+    pub termination: String,
+    /// Plies (half-moves) played in the game.
+    pub length: Option<u32>,
+    pub final_fen: Option<String>,
+    pub computed_result: Option<String>,
+    pub terminal_reason: Option<String>,
+    pub consistent: Option<bool>,
+    pub claimable_draw: Option<bool>,
+    pub error: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AuditSummary {
+    pub games: usize,
+    pub errors: usize,
+    pub inconsistent: usize,
+    pub claimable_draws: usize,
+    pub total_length: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct PgnAudit {
+    pub games: Vec<GameAudit>,
+    pub summary: AuditSummary,
+}
+
+impl PgnAudit {
+    /// An audit passes when every game imported and every marker is consistent.
+    pub fn passed(&self) -> bool {
+        self.summary.errors == 0 && self.summary.inconsistent == 0
+    }
+
+    /// Keep only the games that failed to import or are inconsistent. The
+    /// summary still describes every game of the file.
+    pub fn only_failures(mut self) -> Self {
+        self.games
+            .retain(|g| g.error.is_some() || g.consistent == Some(false));
+        self
+    }
+}
+
+/// Audit every game of a PGN file. A file that cannot be split into games is
+/// refused; a game that fails to import is reported and the audit goes on.
+pub fn audit(text: &str, file_name: &str) -> Result<PgnAudit> {
+    let games: Vec<_> = parse_games(text)?
+        .iter()
+        .enumerate()
+        .map(|(i, game)| audit_game(game, file_name, i + 1))
+        .collect();
+    let imported = || games.iter().filter(|g| g.error.is_none());
+    let summary = AuditSummary {
+        games: games.len(),
+        errors: games.iter().filter(|g| g.error.is_some()).count(),
+        inconsistent: imported().filter(|g| g.consistent == Some(false)).count(),
+        claimable_draws: imported()
+            .filter(|g| g.claimable_draw == Some(true))
+            .count(),
+        total_length: imported().filter_map(|g| g.length).sum(),
+    };
+    Ok(PgnAudit { games, summary })
+}
+
+fn audit_game(game: &PgnGame, file_name: &str, index: usize) -> GameAudit {
+    let mut audit = GameAudit {
+        index,
+        game_id: None,
+        termination: game.termination.clone(),
+        length: None,
+        final_fen: None,
+        computed_result: None,
+        terminal_reason: None,
+        consistent: None,
+        claimable_draw: None,
+        error: None,
+    };
+    match import_game(game, file_name, index).and_then(|record| replay(&record)) {
+        Ok(replayed) => {
+            let result = computed_result(&replayed.state);
+            audit.game_id = Some(replayed.state.record().game_id.clone());
+            audit.length = Some(replayed.length);
+            audit.final_fen = Some(replayed.state.fen());
+            audit.computed_result = Some(result.to_owned());
+            audit.terminal_reason = replayed.state.facts().terminal_reason;
+            audit.consistent = Some(consistent(result, &game.termination));
+            audit.claimable_draw = Some(replayed.claimable_draw);
+        }
+        Err(e) => audit.error = Some(format!("{e:#}")),
+    }
+    audit
+}
+
+struct Replayed {
+    state: GameState,
+    length: u32,
+    claimable_draw: bool,
+}
+
+/// Replay a record move by move, noting whether a draw could be claimed in
+/// any position along the way.
+fn replay(record: &GameRecord) -> Result<Replayed> {
+    let mut state = GameState::replay(&GameRecord {
+        moves: vec![],
+        ..record.clone()
+    })?;
+    let claimable = |state: &GameState| {
+        let facts = state.facts();
+        facts.threefold_claim_now == Some(true) || facts.fifty_move_claim_now
+    };
+    let mut claimable_draw = claimable(&state);
+    for uci in &record.moves {
+        state.play(uci)?;
+        claimable_draw |= claimable(&state);
+    }
+    Ok(Replayed {
+        state,
+        length: record.moves.len() as u32,
+        claimable_draw,
+    })
+}
+
+/// A decisive or drawn final position fixes the marker; a position that
+/// establishes nothing (`*`) is consistent with any marker, since games also
+/// end by resignation, agreement or time.
+fn consistent(computed: &str, termination: &str) -> bool {
+    computed == "*" || computed == termination
+}
