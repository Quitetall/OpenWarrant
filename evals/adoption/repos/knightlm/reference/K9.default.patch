 }
+
+#[test]
+fn pgn_audit_checks_markers_counts_plies_and_reports_bad_games() {
+    let text = std::fs::read_to_string(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../fixtures/audit.pgn"
+    ))
+    .unwrap();
+    let audit = knightlm_core::audit::audit(&text, "audit.pgn").unwrap();
+    assert!(audit.passed());
+    let lengths: Vec<_> = audit.games.iter().map(|g| g.length).collect();
+    assert_eq!(lengths, [Some(4), Some(5), Some(1)]);
+    assert_eq!(audit.summary.total_length, 10);
+    assert_eq!(audit.games[0].computed_result.as_deref(), Some("0-1"));
+    assert_eq!(audit.games[1].computed_result.as_deref(), Some("*"));
+    assert_eq!(
+        audit.games[2].terminal_reason.as_deref(),
+        Some("proven_dead_position")
+    );
+    let bad = "1. f3 e5 2. g4 Qh4# 1-0\n\n1. e4 e5 2. Ke3 *\n\n\
+               [FEN \"4k3/8/8/8/8/8/8/4K3 b - - 0 7\"]\n\n7... Kd7 8. Kd2 Kc6 *\n";
+    let audit = knightlm_core::audit::audit(bad, "bad.pgn").unwrap();
+    assert!(!audit.passed());
+    assert_eq!((audit.summary.errors, audit.summary.inconsistent), (2, 1));
+    assert_eq!(audit.games[0].consistent, Some(false));
+    let error = audit.games[1].error.as_deref().unwrap();
+    assert!(error.starts_with("move 2 (white): illegal or ambiguous SAN \"Ke3\""));
+    assert_eq!(audit.games[1].length, None);
+    // A dead position before the moves makes them illegal: reported, not fatal.
+    assert!(audit.games[2].error.is_some());
+    let failures = audit.only_failures();
+    assert_eq!(failures.games.len(), 3);
+    assert_eq!(failures.summary.games, 3);
+    let clean = knightlm_core::audit::audit(&text, "audit.pgn").unwrap();
+    assert!(clean.only_failures().games.is_empty());
+    assert!(knightlm_core::audit::audit("1. e4 e5\n", "x.pgn").is_err());
+}
