+/// The result a game's final position establishes: `1-0`/`0-1` for checkmate,
+/// `1/2-1/2` for stalemate or any other terminal reason, otherwise `*`.
+/// Claimable draws (threefold, fifty-move) are not terminal and give `*`.
+pub fn computed_result(state: &GameState) -> &'static str {
+    let facts = state.facts();
+    if facts.checkmate {
+        if state.fen().split_whitespace().nth(1) == Some("w") {
+            "0-1"
+        } else {
+            "1-0"
+        }
+    } else if facts.terminal_reason.is_some() {
+        "1/2-1/2"
+    } else {
+        "*"
+    }
+}
