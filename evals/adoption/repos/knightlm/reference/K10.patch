diff --git a/crates/core/tests/contracts.rs b/crates/core/tests/contracts.rs
index b124336..97ff6ae 100644
--- a/crates/core/tests/contracts.rs
+++ b/crates/core/tests/contracts.rs
@@ -638,3 +638,28 @@ fn pgn_audit_checks_markers_counts_full_moves_and_reports_bad_games() {
     assert!(clean.only_failures().games.is_empty());
     assert!(knightlm_core::audit::audit("1. e4 e5\n", "x.pgn").is_err());
 }
+
+#[test]
+fn extract_starts_from_a_stated_position_and_never_claims_history() {
+    let mut s = start();
+    for m in ["e2e4", "e7e5", "g1f3", "b8c6", "f1b5"] {
+        s.play(m).unwrap();
+    }
+    let record = s.record().clone();
+    let middle = knightlm_core::extract::extract(&record, 2, Some(4)).unwrap();
+    assert_eq!(middle.game_id, "fixture@2-4");
+    assert_eq!(middle.moves, ["g1f3", "b8c6"]);
+    assert!(!middle.history_complete);
+    assert_eq!(
+        GameState::replay(&middle).unwrap().fen(),
+        "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3"
+    );
+    let whole = knightlm_core::extract::extract(&record, 0, None).unwrap();
+    assert_eq!(whole.initial_fen, START_FEN);
+    assert_eq!(whole.moves, record.moves);
+    assert!(!whole.history_complete);
+    for (from, to) in [(3, Some(2)), (0, Some(6)), (6, None)] {
+        let err = knightlm_core::extract::extract(&record, from, to).unwrap_err();
+        assert!(err.to_string().starts_with("ply range out of bounds"));
+    }
+}
