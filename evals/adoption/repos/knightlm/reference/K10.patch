diff --git a/crates/core/src/extract.rs b/crates/core/src/extract.rs
new file mode 100644
index 0000000..c67d087
--- /dev/null
+++ b/crates/core/src/extract.rs
@@ -0,0 +1,31 @@
+//! Extract a ply range of a game as a record of its own.
+use anyhow::{Result, ensure};
+
+use crate::state::{GameRecord, GameState};
+
+/// The moves `from..to` (plies counted from the record's first move) as a new
+/// record that starts from the position after `from` plies. That start is a
+/// stated position, never a proven history, even when `from` is 0: like a PGN
+/// game with a `FEN` tag, the extract never claims complete history.
+pub fn extract(record: &GameRecord, from: usize, to: Option<usize>) -> Result<GameRecord> {
+    // Replaying the whole record first refuses an invalid one.
+    GameState::replay(record)?;
+    let to = to.unwrap_or(record.moves.len());
+    ensure!(
+        from <= to && to <= record.moves.len(),
+        "ply range out of bounds: {from}..{to} of {} plies",
+        record.moves.len()
+    );
+    let start = GameState::replay(&GameRecord {
+        moves: record.moves[..from].to_vec(),
+        ..record.clone()
+    })?;
+    Ok(GameRecord {
+        schema_version: record.schema_version,
+        game_id: format!("{}@{from}-{to}", record.game_id),
+        source: format!("extract:{}", record.source),
+        initial_fen: start.fen(),
+        history_complete: false,
+        moves: record.moves[from..to].to_vec(),
+    })
+}
