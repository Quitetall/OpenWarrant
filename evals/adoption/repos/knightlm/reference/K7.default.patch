diff --git a/crates/core/tests/contracts.rs b/crates/core/tests/contracts.rs
index b5c11ea..77a08e7 100644
--- a/crates/core/tests/contracts.rs
+++ b/crates/core/tests/contracts.rs
@@ -521,3 +521,33 @@ fn observation_mismatches_are_listed_per_square_and_malformed_input_refused() {
         assert_eq!(err.to_string(), "malformed observation placement", "{bad}");
     }
 }
+
+#[test]
+fn encoding_lists_squares_in_square_order_and_mirrors_when_relative() {
+    let mut s = start();
+    for m in ["e2e4", "a7a6", "e4e5", "d7d5"] {
+        s.play(m).unwrap();
+    }
+    let absolute = knightlm_core::encode::encode(&s, false);
+    assert_eq!(absolute.squares.len(), 64);
+    assert_eq!(absolute.squares[0], "R");
+    assert_eq!(absolute.squares[63], "r");
+    // e5 is rank 5, file e: index (5 - 1) * 8 + 4.
+    assert_eq!(absolute.squares[4 * 8 + 4], "P");
+    assert_eq!(absolute.en_passant.as_deref(), Some("d6"));
+    assert_eq!(absolute.side_to_move, "white");
+    let mut black = start();
+    black.play("e2e4").unwrap();
+    let relative = knightlm_core::encode::encode(&black, true);
+    assert_eq!(relative.squares[0], "R");
+    assert_eq!(relative.squares[63], "r");
+    // Black's own pawns appear uppercase on the second rank from the bottom.
+    assert_eq!(relative.squares[8 + 4], "P");
+    // White's e4 pawn becomes a lowercase pawn on e5.
+    assert_eq!(relative.squares[4 * 8 + 4], "p");
+    assert_eq!(relative.en_passant, None);
+    assert_eq!(relative.side_to_move, "black");
+    assert_eq!(knightlm_core::encode::encode(&start(), true).squares, {
+        knightlm_core::encode::encode(&start(), false).squares
+    });
+}
