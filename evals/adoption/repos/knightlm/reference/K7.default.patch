diff --git a/crates/core/src/encode.rs b/crates/core/src/encode.rs
new file mode 100644
index 0000000..e93294d
--- /dev/null
+++ b/crates/core/src/encode.rs
@@ -0,0 +1,92 @@
+//! Flat, model-facing encoding of the current position. Every field is derived
+//! from the replayed ledger; nothing is inferred from an image or a bare FEN.
+use serde::Serialize;
+
+use crate::state::{GameState, parse_placement};
+
+/// Castling rights of the position (or of the side to move, when relative).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct CastlingRights {
+    pub white_king_side: bool,
+    pub white_queen_side: bool,
+    pub black_king_side: bool,
+    pub black_queen_side: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct BoardEncoding {
+    pub fen: String,
+    pub side_to_move: String,
+    pub relative: bool,
+    /// 64 one-character strings, FEN piece letters or `.`, in square order:
+    /// index 0 is a1, index 7 is h1, index 56 is a8, index 63 is h8.
+    pub squares: Vec<String>,
+    pub castling: CastlingRights,
+    /// Only when an en passant capture is legal now.
+    pub en_passant: Option<String>,
+    pub halfmove_clock: u32,
+    pub fullmove_number: u32,
+    pub repetition_count: Option<u32>,
+}
+
+/// Encode the current position. With `relative` and Black to move, the board is
+/// mirrored vertically with colours swapped, so the side to move is uppercase
+/// and moves up the board; castling and en passant are mirrored to match.
+pub fn encode(state: &GameState, relative: bool) -> BoardEncoding {
+    let fen = state.fen();
+    let fields: Vec<_> = fen.split_whitespace().collect();
+    let squares = parse_placement(fields[0]).expect("ledger placement is well formed");
+    let black = fields[1] == "b";
+    let flip = relative && black;
+    let rights = fields[2];
+    let mut castling = CastlingRights {
+        white_king_side: rights.contains('K'),
+        white_queen_side: rights.contains('Q'),
+        black_king_side: rights.contains('k'),
+        black_queen_side: rights.contains('q'),
+    };
+    let mut en_passant = state.usable_en_passant();
+    let mut cells = Vec::with_capacity(64);
+    for index in 0..64 {
+        // Square order a1, b1, ..., h1, a2, ..., h8.
+        let (rank, file) = (index / 8, index % 8);
+        let rank = if flip { 7 - rank } else { rank };
+        let cell = match squares[rank * 8 + file] {
+            Some(piece) if flip => swap_case(piece),
+            Some(piece) => piece,
+            None => '.',
+        };
+        cells.push(cell.to_string());
+    }
+    if flip {
+        castling = CastlingRights {
+            white_king_side: castling.black_king_side,
+            white_queen_side: castling.black_queen_side,
+            black_king_side: castling.white_king_side,
+            black_queen_side: castling.white_queen_side,
+        };
+        en_passant = en_passant.map(|square| {
+            let (file, rank) = square.split_at(1);
+            format!("{file}{}", 9 - rank.parse::<u32>().expect("square rank"))
+        });
+    }
+    BoardEncoding {
+        side_to_move: if black { "black" } else { "white" }.into(),
+        relative,
+        squares: cells,
+        castling,
+        en_passant,
+        halfmove_clock: fields[4].parse().expect("ledger counter"),
+        fullmove_number: fields[5].parse().expect("ledger counter"),
+        repetition_count: state.facts().repetition_count,
+        fen,
+    }
+}
+
+fn swap_case(piece: char) -> char {
+    if piece.is_ascii_uppercase() {
+        piece.to_ascii_lowercase()
+    } else {
+        piece.to_ascii_uppercase()
+    }
+}
