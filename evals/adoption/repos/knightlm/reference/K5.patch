+
+/// PGN export format: the Seven Tag Roster (unknowns as `?`, `Site` carries the
+/// game id), `SetUp`/`FEN` unless the record starts from the standard position
+/// with complete history, then SAN movetext wrapped at 79 columns.
+pub fn export(record: &GameRecord) -> Result<String> {
+    let mut state = GameState::replay(&GameRecord {
+        moves: vec![],
+        ..record.clone()
+    })?;
+    let mut tokens = Vec::new();
+    for (ply, uci) in record.moves.iter().enumerate() {
+        let fen = state.fen();
+        let fields: Vec<_> = fen.split_whitespace().collect();
+        if fields[1] == "w" {
+            tokens.push(format!("{}.", fields[5]));
+        } else if ply == 0 {
+            tokens.push(format!("{}...", fields[5]));
+        }
+        tokens.push(
+            state
+                .san(uci)
+                .with_context(|| format!("move {}", ply + 1))?,
+        );
+        state
+            .play(uci)
+            .with_context(|| format!("move {}", ply + 1))?;
+    }
+    let facts = state.facts();
+    let result = if facts.checkmate {
+        if state.fen().split_whitespace().nth(1) == Some("w") {
+            "0-1"
+        } else {
+            "1-0"
+        }
+    } else if facts.terminal_reason.is_some() {
+        "1/2-1/2"
+    } else {
+        "*"
+    };
+    tokens.push(result.to_owned());
+    let escape = |v: &str| v.replace('\\', "\\\\").replace('"', "\\\"");
+    let mut tags = vec![
+        ("Event", "?".to_owned()),
+        ("Site", escape(&record.game_id)),
+        ("Date", "????.??.??".to_owned()),
+        ("Round", "?".to_owned()),
+        ("White", "?".to_owned()),
+        ("Black", "?".to_owned()),
+        ("Result", result.to_owned()),
+    ];
+    if record.initial_fen != START_FEN || !record.history_complete {
+        tags.push(("SetUp", "1".to_owned()));
+        tags.push(("FEN", escape(&record.initial_fen)));
+    }
+    let mut out = String::new();
+    for (name, value) in tags {
+        out.push_str(&format!("[{name} \"{value}\"]\n"));
+    }
+    out.push('\n');
+    let mut line = String::new();
+    for token in tokens {
+        if !line.is_empty() && line.len() + 1 + token.len() > 79 {
+            out.push_str(&line);
+            out.push('\n');
+            line.clear();
+        }
+        if !line.is_empty() {
+            line.push(' ');
+        }
+        line.push_str(&token);
+    }
+    out.push_str(&line);
+    out.push('\n');
+    Ok(out)
+}
