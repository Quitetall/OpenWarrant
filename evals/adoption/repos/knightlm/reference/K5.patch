+
+#[test]
+fn pgn_export_round_trips_through_import() {
+    let mut fool = start();
+    for m in ["f2f3", "e7e5", "g2g4", "d8h4"] {
+        fool.play(m).unwrap();
+    }
+    let record = GameRecord {
+        game_id: "fool".into(),
+        ..fool.record().clone()
+    };
+    let pgn = knightlm_core::pgn::export(&record).unwrap();
+    assert!(pgn.ends_with("\n\n1. f3 e5 2. g4 Qh4# 0-1\n"), "{pgn}");
+    let back = knightlm_core::pgn::import(&pgn, "x.pgn", 1).unwrap();
+    assert_eq!(
+        (
+            back.game_id,
+            back.initial_fen,
+            back.history_complete,
+            back.moves
+        ),
+        (record.game_id, record.initial_fen, true, record.moves)
+    );
+}
