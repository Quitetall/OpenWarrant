+        let (code, refused) =
+            repo.run(&["sas", "accept", "1.0.0-rc.2", "--response", "response.toml"]);
+        assert_ne!(code, 0);
+        assert!(refused.to_string().contains(reason), "{refused}");
+        assert_eq!(request, repo.ok(&["sas", "accept", "1.0.0-rc.2"]));
+    }
