,"format":"uint32","minimum":0.0,"type":"integer"},"seed":{"default":42,"format":"uint64","minimum":0.0,"type":"integer"},"seq_len":{"default":4096,"format":"uint32","minimum":0.0,"type":"integer"}},"required":["base_model","epochs","lr"],"type":"object"}}}},{"name":"materialize_conversations","input_kind":"()","output_kind":"dataset.jsonl","args_schema":{"$ref":"#/definitions/Args","definitions":{"Args":{"properties":{"since_seconds":{"description":"How far back to pull, in seconds. Recipes convert humantime strings to seconds before constructing Args so the JsonSchema is a clean integer.","format":"uint64","minimum":0.0,"type":"integer"}},"required":["since_seconds"],"type":"object"}}}},{"name":"materialize_dataset_path","input_kind":"()","output_kind":"dataset.jsonl","args_schema":{"$ref":"#/definitions/Args","definitions":{"Args":{"properties":{"path":{"default":null,"description":"Path to a JSONL dataset on disk. Exclusive with `registered_name`.","type":["string","null"]},"registered_name":{"default":null,"description":"Registered dataset name in `datasets_db`. Exclusive with `path`.","type":["string","null"]}},"type":"object"}}}},{"name":"materialize_for_eval","input_kind":"()","output_kind":"tuple<2>","args_schema":{"$ref":"#/definitions/Args","definitions":{"Args":{"properties":{"base_model":{"default":"","description":"Recorded base model id (for provenance).","type":"string"},"dataset_path":{"description":"Path to the eval JSONL.","type":"string"},"model_path":{"description":"Path to the HuggingFace checkpoint directory.","type":"string"}},"required":["dataset_path","model_path"],"type":"object"}}}},{"name":"merge_lora","input_kind":"checkpoint.hf","output_kind":"checkpoint.hf","args_schema":{"$ref":"#/definitions/Args","definitions":{"Args":{"properties":{"passthrough_only":{"default":false,"description":"When false, attempt a real merge subprocess. When true, only relabel the method_tag (useful for tests + for already-merged checkpoints). Defaults to fa