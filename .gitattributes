# Historical sources and parser fixtures are byte-preserving artifacts.
archive/** -text
archive/legacy-20260914/history.bundle binary
archive/legacy-20260914/snapshots/*.tar.gz binary
conformance/sdk/document/** -text
conformance/sdk/document/*.bin binary
docs/warrants/OW-WAR-0075/evidence/sdk-parser/** -text
docs/design/amendment-review/*.log -text
docs/design/amendment-review/*-signing-preview.txt -text
conformance/sdk/author/** -text
docs/warrants/OW-WAR-0076/evidence/sdk-author/** -text

# war (M11): journals are append-only lines, so a merge keeps both sides'.
**/journal.jsonl merge=union
# war (M11): ticket checklists merge item by item, notes by appending
# (`war merge-ticket`; `war merge-ticket --install` configures this clone).
docs/tickets/*/atoms/*.md merge=war-ticket
