# Repository configuration (SAS §60).
#
# `war init --namespace <NS>` writes this file. It is shown here annotated.

schema = "oh.war/repository-config/v1"

[project]
# Free-text project name.
name = "OpenWarrant"

# Prefixes every local alias in this repository: `OW` gives `OW-WAR-0001`.
#
# A local alias is NOT a global identifier (§12.3, RQ-002). Two repositories may
# both hold `OW-WAR-0001` and they are different records; only the UUIDv7
# distinguishes them. Changing this after warrants exist orphans their aliases,
# which is why `war init` refuses to overwrite an initialized repository.
namespace = "OW"

# Set once the project is registered with Knowledge Fabric. Registration adds
# global authority; it does not transfer source authority away from Git (§12.5,
# RQ-004).
# knowledge_fabric_project_ref = "project://openwarrant"

[paths]
# Semantics are NOT inferred from paths (§59). A directory is the warrant tree
# because this field says so, not because of what it is called. Paths are
# relative to the repository root; absolute paths are refused because they would
# resolve to one machine's layout.
sas = "docs/sas"
roadmap = "docs/roadmap"
adrs = "docs/adr"
warrants = "docs/warrants"

[generated]
# Generated-view policy (§59.2).
#
# `commit = true` tracks compiled parents in Git, which is what makes
# `verify_drift` possible: a fresh compilation can be compared against what was
# committed, and §17.3 requires that comparison to FAIL on a difference.
#
# Setting `commit = false` is permitted and removes the comparison. The authority
# of the source atoms is unchanged either way — a generated parent is never
# authoritative merely because it is in Git (§17.2).
commit = true
verify_drift = true

# §46.1's nine independence dimensions, for verification performed in this
# repository. Absent means UNDECLARED, and `war check` says so rather than
# assume §46.1's mostly-true defaults. Each ingested verdict is still judged on
# its own flags; this table only lets `war check` report §46.3's minimums.
#
# [independence]
# performer_transcript_blind = true
# performer_rationale_blind = true
# separate_writable_workspace = true
# cannot_modify_subject_artifacts = true
# cannot_modify_gate_definition = true
# cannot_modify_gate_fixtures = true
# separate_context_compilation = true
# distinct_model_required = false
# distinct_human_required = false
#
# A repository where one person holds every role (a solo owner working through
# agents) declares that instead, once. It is the same as nine `false`
# dimensions and claims nothing: no minimum is met, the compliance score does
# not move, and `war check` states the gap as one note rather than a WARN on
# every run. A dimension set `true` beside it is refused by name
# (independence.single-actor-contradicted). docs/VERIFICATION.md.
#
# [independence]
# single_actor = true
