#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Native setsid/exec for this plant's option-free commands on Linux and macOS."""
import os
import sys

if len(sys.argv) < 2 or sys.argv[1].startswith("-"):
    raise SystemExit("usage: setsid command [arguments...]")
try:
    # Match setsid's default behavior when invoked as a group leader: the
    # child can create a session; its parent returns without waiting.
    if os.getpgrp() == os.getpid() and os.fork():
        os._exit(0)
    os.setsid()
    os.execvp(sys.argv[1], sys.argv[1:])
except OSError as error:
    print(f"native setsid refused: {error}", file=sys.stderr)
    raise SystemExit(1) from error
