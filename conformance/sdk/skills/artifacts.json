            "kind": "binding",
            "text": "## Scope\n\nSignup form and API validation only. Payment and deletion excluded.\n"
          },
          {
            "id": "context",
            "kind": "binding",
            "text": "## Context\n\nExact governing source: example:email-policy revision 2.\nEmail verification is required before account activation.\n"
          },
