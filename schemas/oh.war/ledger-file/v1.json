{"$defs":{"Earlier":{"description":"Older entries, folded.","properties":{"count":{"format":"uint","minimum":0,"type":"integer"},"first":{"type":"string"},"last":{"type":"string"},"text":{"description":"The folded reasons, joined by ` | ` and cut at 400 characters.","type":"string"},"warrants":{"items":{"type":"string"},"type":"array"}},"required":["count","first","last","text"],"type":"object"},"Entry":{"description":"One change to one file.","properties":{"commit":{"description":"The full commit id, or absent for a change recorded before its commit.","type":["string","null"]},"date":{"description":"`YYYY-MM-DD`: the commit's committer date, or the day an uncommitted\nchange was recorded.","type":"string"},"source":{"$ref":"#/$defs/Source"},"warrant":{"description":"The Warrant the change cites, when it cites one.","type":["string","null"]},"why":{"type":"string"}},"required":["date","source","why"],"type":"object"},"Source":{"description":"Where a why came from.","oneOf":[{"const":"commit","description":"A `Ledger:` trailer or the commit body.","type":"string"},{"const":"deterministic","description":"The Warrant's title or the commit subject.","type":"string"},{"const":"agent","description":"Text an agent gave at done.","type":"string"},{"const":"agent-trace","description":"Read from an Agent Trace record.","type":"string"},{"const":"git-ai","description":"Read from a git-ai note (`refs/notes/ai`).","type":"string"}]}},"$id":"oh.war/ledger-file/v1","$schema":"https://json-schema.org/draft/2020-12/schema","description":"One line of `.openwarrant/ledger.jsonl`.","properties":{"atom":{"description":"The atom it compiles from.","type":"string"},"earlier":{"anyOf":[{"$ref":"#/$defs/Earlier"},{"type":"null"}]},"entries":{"items":{"$ref":"#/$defs/Entry"},"type":"array"},"path":{"description":"The file, repository-relative.","type":"string"},"schema":{"type":"string"}},"required":["schema","path","atom","entries"],"title":"Line","type":"object"}
