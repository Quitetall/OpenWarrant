{"$defs":{"Dimension":{"description":"One row of the scorecard.","properties":{"denominator":{"format":"uint64","minimum":0,"type":["integer","null"]},"detail":{"description":"What was counted, or why it could not be.","type":"string"},"id":{"type":"string"},"numerator":{"format":"uint64","minimum":0,"type":["integer","null"]},"points":{"format":"uint32","minimum":0,"type":"integer"},"status":{"$ref":"#/$defs/Status"},"weight":{"format":"uint32","minimum":0,"type":"integer"}},"required":["id","weight","status","points","detail"],"type":"object"},"Level":{"description":"The derived level.","properties":{"name":{"type":"string"},"number":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["number","name"],"type":"object"},"Predicate":{"description":"The score, as the predicate.","properties":{"dimensions":{"items":{"$ref":"#/$defs/Dimension"},"type":"array"},"level":{"$ref":"#/$defs/Level"},"producer":{"anyOf":[{"$ref":"#/$defs/Producer"},{"type":"null"}]},"score":{"format":"uint32","minimum":0,"type":"integer"},"weights":{"type":"string"},"window":{"anyOf":[{"$ref":"#/$defs/Window"},{"type":"null"}]}},"required":["weights","score","level","dimensions"],"type":"object"},"Producer":{"description":"What produced the statement.","properties":{"name":{"type":"string"},"version":{"type":"string"}},"required":["name","version"],"type":"object"},"Status":{"description":"Whether a dimension was measured.","oneOf":[{"enum":["measured"],"type":"string"},{"const":"unknown","description":"Could not be measured: earns 0, and is never a pass.","type":"string"}]},"Subject":{"description":"The repository at the measured commit.","properties":{"digest":{"additionalProperties":{"type":"string"},"description":"`gitCommit` → the full commit id.","type":"object"},"name":{"type":"string"}},"required":["name","digest"],"type":"object"},"Window":{"description":"What the commit and PR dimensions looked at.","properties":{"baseline":{"description":"`[adoption] baseline`: