{"$defs":{"CommonOutcome":{"description":"§56.2's `common_outcome`.","enum":["satisfied","not_satisfied","falsified","cancelled","blocked"],"type":"string"},"Locator":{"description":"Where the delivered bytes were when the resolution was recorded\n(OW-ADR-0021, §56.2 `locator`). Optional: records made before this\nexisted have none and read as UNKNOWN when history is asked for, which is\nthe honest answer rather than a commit guessed from the log.","properties":{"commit_sha":{"description":"`git rev-parse HEAD` at ingest, forty lowercase hex.","type":"string"},"paths_dirty":{"items":{"type":"string"},"type":"array"},"worktree_clean":{"description":"Whether every declared deliverable was committed at that moment. A\ndirty path means the bytes the resolution bound are NOT the ones at\n`commit_sha`, and `paths_dirty` says which.","type":"boolean"}},"required":["commit_sha","worktree_clean"],"type":"object"},"Resolution":{"description":"§56.2's resolution record.","properties":{"acting_role_ref":{"type":"string"},"artifact_manifest_digest":{"type":"string"},"assurance_case_snapshot_digest":{"type":"string"},"common_outcome":{"$ref":"#/$defs/CommonOutcome"},"contract_digest":{"type":"string"},"contract_revision":{"format":"uint32","minimum":0,"type":"integer"},"effective_at":{"type":"string"},"gate_run_refs":{"default":[],"items":{"type":"string"},"type":"array"},"id":{"type":"string"},"judgment_refs":{"default":[],"items":{"type":"string"},"type":"array"},"meaning":{"description":"§56.2's `meaning`. What acceptance actually asserts, in one sentence —\nthis is the field that stops \"resolved\" being read as \"correct\".","type":"string"},"profile_outcome":{"type":"string"},"recorded_at":{"type":"string"},"residual_risk_refs":{"default":[],"items":{"type":"string"},"type":"array"},"resolved_by_ref":{"type":"string"},"standing":{"$ref":"#/$defs/ResolutionStanding","default":"valid"}},"required":["id","common_outcome","profile_outcome","contract_revision","contract_digest",